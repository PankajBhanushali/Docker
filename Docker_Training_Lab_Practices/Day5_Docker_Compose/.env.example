# .env example file for Docker Compose configuration
# Copy this to .env and fill in your values

# Database Configuration
POSTGRES_DB=training
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Training@123
DATABASE_CONNECTION_STRING=Server=postgres;Port=5432;Database=training;User Id=postgres;Password=Training@123;

# Redis Configuration
REDIS_PASSWORD=RedisPassword@123
REDIS_CONNECTION_STRING=redis:6379

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
SERVICE_NAME=training-web-api
LOG_LEVEL=Information

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=docker-training
COMPOSE_FILE=docker-compose.yml

# Port Configuration
WEB_API_PORT=5030
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=80
PGADMIN_PORT=5050

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_COMPRESSION=true

# External Services (if any)
# EXTERNAL_API_URL=https://api.example.com
# EXTERNAL_API_KEY=your-api-key-here
