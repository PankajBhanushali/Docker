# Web API Dockerfile for Docker Compose
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["Day5_WebAPI.csproj", "."]
RUN dotnet restore "Day5_WebAPI.csproj"
COPY . .
RUN dotnet build "Day5_WebAPI.csproj" -c Release -o /app/build

FROM build AS development
WORKDIR /src
# Keep SDK for development, watch mode, etc
RUN dotnet tool install -g dotnet-watch

FROM build AS publish
RUN dotnet publish "Day5_WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS final
WORKDIR /app
RUN apk add --no-cache curl

COPY --from=publish /app/publish .

LABEL maintainer="Docker Training Team"
LABEL version="5.0.0"
LABEL description="Docker Compose Training - Day 5 Web API"

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "Day5_WebAPI.dll"]
